{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meridian",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  // no_handle_cross_request_promise_resolution: Next.js's response cache shares
  // promises between overlapping requests, which newer Workers runtimes block
  // (every page hung with Error 1101 without it)
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "no_handle_cross_request_promise_resolution"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
